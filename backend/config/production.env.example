# Template for config/production.env. **Committed**, and therefore blank where a
# value is secret. Copy to config/production.env and fill it in.
#
# Loaded on top of config/local.env when VOICEIQ_ENV=production, so it only
# states what differs. Terraform also reads the VOICEIQ_MODEL_* lines out of this
# file, which is what makes the model written here the model Cloud Run runs.
#
# Recreate from config/production.env.example in a fresh clone.

# Real GCP, real Gemini, real Firestore.
VOICEIQ_MOCK=0

# --- Google Cloud / Firebase -------------------------------------------------
VOICEIQ_GCP_PROJECT=voiceiq-505205
VOICEIQ_GCP_REGION=us-central1
VOICEIQ_FIREBASE_PROJECT=voiceiq-505205
VOICEIQ_AUDIO_BUCKET=voiceiq-audio-voiceiq-505205
VOICEIQ_KMS_KEY=projects/../locations/../keyRings/../cryptoKeys/..
VOICEIQ_PUBSUB_INGEST_TOPIC=voiceiq-ingest

# --- Model slots -------------------------------------------------------------
# Terraform parses these three and sets them on Cloud Run. Change a model here
# and `terraform apply` carries it to production.
VOICEIQ_MODEL_REASONING=gemini-2.5-flash
VOICEIQ_MODEL_LIVE=gemini-live-2.5-flash-native-audio
VOICEIQ_MODEL_EMBEDDING=text-multilingual-embedding-002
VOICEIQ_EMBEDDING_DIM=256

# --- App behaviour -----------------------------------------------------------
VOICEIQ_SIGNED_URL_TTL_SECONDS=900
VOICEIQ_RAG_TOP_K=6
VOICEIQ_DEFAULT_ANSWER_LANGUAGE=auto

# --- Email (Azure Communication Services) ------------------------------------
# Terraform reads the connection string from here and stores it in Secret Manager
# (`voiceiq-acs-connection`), which Cloud Run mounts into this same env var. So
# this file is the source, and the deployed service never carries the credential
# as a readable value. `terraform apply` after changing it publishes a new secret
# version; the next revision picks it up.
#
# The sender is not a credential — it appears on every email — so it is set as a
# plain env var.
#
# Leave the connection string blank here: this file is committed. `terraform
# apply` fails with a clear message rather than publishing an empty secret.
VOICEIQ_ACS_CONNECTION_STRING=
VOICEIQ_ACS_SENDER=DoNotReply@nativemindsai.com
VOICEIQ_ACS_FORCE_SEND=0
