# Local, emulator and test configuration. **Committed** — it holds nothing secret,
# and every developer should get the same offline behaviour from a fresh clone.
#
# This file is always loaded first, as the base. `VOICEIQ_ENV=production` then
# layers config/production.env on top, so that file only has to state what
# genuinely differs. `VOICEIQ_ENV` is unset by default, so the safe, offline,
# credential-free profile is what you get unless you ask for otherwise.

# Mock mode: the API and the whole pipeline run in memory. No cloud, no keys.
VOICEIQ_MOCK=1

# --- Google Cloud / Firebase -------------------------------------------------
# Empty on purpose. An empty project is also what makes `mock` default to true,
# so a half-configured local run fails closed to the fake rather than reaching
# for real infrastructure.
VOICEIQ_GCP_PROJECT=
VOICEIQ_GCP_REGION=us-central1
VOICEIQ_FIREBASE_PROJECT=
VOICEIQ_AUDIO_BUCKET=voiceiq-audio
VOICEIQ_KMS_KEY=
VOICEIQ_PUBSUB_INGEST_TOPIC=voiceiq-ingest

# --- Model slots -------------------------------------------------------------
# Unused in mock mode, but kept in step with production so the two files can be
# diffed meaningfully. Never a "-latest" alias: Vertex publishes none.
VOICEIQ_MODEL_REASONING=gemini-2.5-flash
VOICEIQ_MODEL_LIVE=gemini-live-2.5-flash-native-audio
VOICEIQ_MODEL_EMBEDDING=text-multilingual-embedding-002
VOICEIQ_EMBEDDING_DIM=256

# --- App behaviour -----------------------------------------------------------
VOICEIQ_SIGNED_URL_TTL_SECONDS=900
VOICEIQ_RAG_TOP_K=6
VOICEIQ_DEFAULT_ANSWER_LANGUAGE=auto

# --- Email (Azure Communication Services) ------------------------------------
# Blank, and blank is what makes mock mode suppress sending. Real credentials
# belong in config/production.env, which is gitignored.
VOICEIQ_ACS_CONNECTION_STRING=
VOICEIQ_ACS_SENDER=
VOICEIQ_ACS_FORCE_SEND=0
