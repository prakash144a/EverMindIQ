# Copy to .env. With mock mode on (default when no GCP project is set), the API and
# pipeline run fully in-memory — no cloud credentials needed. Great for local dev & tests.

# Set to 0 to use real GCP/Gemini (requires the [gcp] extras and credentials).
VOICEIQ_MOCK=1

# --- Google Cloud / Firebase (real mode) ---
VOICEIQ_GCP_PROJECT=
VOICEIQ_GCP_REGION=us-central1
VOICEIQ_FIREBASE_PROJECT=
VOICEIQ_AUDIO_BUCKET=voiceiq-audio
VOICEIQ_KMS_KEY=                       # projects/../locations/../keyRings/../cryptoKeys/..
VOICEIQ_PUBSUB_INGEST_TOPIC=voiceiq-ingest

# --- Model slots (independently swappable; verify latest GA in Vertex AI Model Garden) ---
VOICEIQ_MODEL_REASONING=gemini-flash-latest
VOICEIQ_MODEL_LIVE=gemini-live-latest
VOICEIQ_MODEL_EMBEDDING=text-multilingual-embedding-latest
VOICEIQ_EMBEDDING_DIM=256

# --- App behavior ---
VOICEIQ_SIGNED_URL_TTL_SECONDS=900
VOICEIQ_RAG_TOP_K=6
VOICEIQ_DEFAULT_ANSWER_LANGUAGE=auto    # "auto" = match the question; or an ISO code like "en"
