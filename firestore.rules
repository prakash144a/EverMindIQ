rules_version = '2';

// VoiceIQ Firestore rules.
// Every document lives under users/{uid}/... and is readable/writable only by that user.
// The backend uses the Admin SDK, which bypasses these rules; they protect any direct client access.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // All subcollections (recordings, chunks, insights, memoryFeed) inherit owner-only access.
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
