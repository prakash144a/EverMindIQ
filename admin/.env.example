# Copy to .env.local and fill in. Everything here is public by design — the
# Firebase web config is meant to ship in the page, and every authorization
# decision is made server-side by the backend's admin allowlist.

# Where the backend lives.
VITE_API_BASE_URL=http://localhost:8000

# From a WEB app registered in Firebase project voiceiq-505205. The existing
# registration is Android-only, so a new web app has to be added, and the Google
# sign-in provider enabled (only Anonymous is on today).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=voiceiq-505205.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=voiceiq-505205
VITE_FIREBASE_APP_ID=
