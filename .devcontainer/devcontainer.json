{
  "name": "VoiceIQ",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "VoiceIQ API" }
  },
  "postCreateCommand": "pip install -e 'backend[dev]'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  }
}
